# Copy to analytics/.env and source it from the repo root (see README).
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=replace-with-your-token
# Use an existing Unity Catalog catalog; initialization creates the schema below it.
SAFESTEP_TABLE=your_catalog.safestep.lifecycle_events
INGEST_BATCH=10
INGEST_POLL_S=5
# Optional absolute paths:
# SAFESTEP_EVENT_LOG=/path/to/events.jsonl
# SAFESTEP_CHECKPOINT=/path/to/.ingest_offset

# Weekly report SMTP transport. Schedule / recipients: analytics/reports/config.json.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
